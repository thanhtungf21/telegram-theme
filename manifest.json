{
  "manifest_version": 3,
  "name": "Chat Theme (Messenger, Telegram Web K)",
  "version": "0.12.0",
  "description": "Đổi giao diện Messenger web và Telegram Web K theo phong cách Telegram, trang review code hoặc app chat AI, kèm ẩn ảnh/sticker/preview link và thu gọn sidebar. Chỉ đổi giao diện, không đọc tin nhắn.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Chat Theme",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://www.messenger.com/*"],
      "css": [
        "themes/messenger/base.css",
        "themes/messenger/telegram.css",
        "themes/messenger/github.css",
        "themes/messenger/ai.css",
        "themes/hide-media.css",
        "themes/toolbar.css"
      ],
      "js": ["src/content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.telegram.org/k/*"],
      "css": [
        "themes/telegram-web/base.css",
        "themes/telegram-web/github.css",
        "themes/telegram-web/ai.css",
        "themes/hide-media.css",
        "themes/toolbar.css"
      ],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ]
}
